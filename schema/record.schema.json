{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://record-anything.dev/schema/record-v1.json",
  "title": "History record v1",
  "description": "One History record as produced by a collector or plugin. Hub-only fields (t_received, dup_of) are not part of the wire format. See docs/contracts.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "device", "source", "kind", "t_start", "title", "body", "capture", "sensitivity"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID generated on the device" },
    "schema": { "const": 1 },
    "device": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "source": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$", "description": "e.g. mac.screen, mac.shell, claude_code.session" },
    "source_ref": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable natural key inside the source (e.g. session id + hour, browser visit id). The hub treats (source, source_ref) as unique, so re-emitting the same item is a no-op. Required for every source that re-reads an external store."
    },
    "kind": { "enum": ["span", "event"] },
    "t_start": { "type": "string", "format": "date-time" },
    "t_end": { "type": ["string", "null"], "format": "date-time" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "type": ["string", "null"], "description": "bundle id or tool name" },
        "window": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "repo": { "type": ["string", "null"], "description": "absolute path of git toplevel, ~ expanded" },
        "cwd": { "type": ["string", "null"] },
        "chat": { "type": ["string", "null"] },
        "place": { "type": ["string", "null"] },
        "extra": { "type": "object", "description": "source-specific small scalars" }
      }
    },
    "people": { "type": "array", "items": { "type": "string" } },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "one-line brief, rule-generated where possible" },
    "body": { "type": "string", "maxLength": 200000, "description": "detail text" },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "enum": ["audio"] },
          "expires": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "enum": ["ax", "ocr", "asr", "db", "file", "hook", "api", "manual"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sensitivity": { "enum": ["normal", "private", "redacted"] },
    "redactions": { "type": "integer", "minimum": 0, "description": "secrets replaced before this record left its producer" },
    "corrects": { "type": ["string", "null"], "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "span" } } },
      "then": { "required": ["t_end"], "properties": { "t_end": { "type": "string" } } }
    }
  ]
}
